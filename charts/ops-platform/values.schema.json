{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {"$ref": "#/definitions/image"},
    "referenceImage": {"$ref": "#/definitions/image"},
    "postgresImage": {"$ref": "#/definitions/image"},
    "neonEnabled": {"const": false},
    "replicas": {"type": "integer", "minimum": 1, "maximum": 4},
    "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767},
    "configSecret": {"type": "string", "minLength": 1},
    "databaseSecret": {"type": "string", "minLength": 1},
    "tlsSecret": {"type": "string", "minLength": 1}
  },
  "required": ["image", "referenceImage", "postgresImage", "neonEnabled"],
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["repository", "digest"]
    }
  }
}
